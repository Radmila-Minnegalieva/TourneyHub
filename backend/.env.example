# Local development only. When changing POSTGRES_PASSWORD, update both URLs.
POSTGRES_PASSWORD=tourneyhub_local
POSTGRES_PORT=5433
API_PORT=8080
SWAGGER_PORT=8081
COMPOSE_DATABASE_URL=postgres://tourneyhub:tourneyhub_local@postgres:5432/tourneyhub?sslmode=disable
# Used by make run (host), not by Compose containers.
DATABASE_URL=postgres://tourneyhub:tourneyhub_local@localhost:5433/tourneyhub?sslmode=disable
HTTP_ADDRESS=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
